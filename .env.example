# Copy to .env and replace every value. Never commit .env.
SUMA_DB_USER=suma
SUMA_DB_PASSWORD=change-me-db-password
# At least 32 random bytes, e.g. `openssl rand -base64 48`
SUMA_JWT_SECRET=change-me-generate-a-long-random-secret-value-here
# Key for encrypting integration credentials at rest (`openssl rand -base64 32`). Changing it makes stored credentials unreadable.
SUMA_ENCRYPTION_KEY=change-me-generate-a-random-key
# Initial administrator password (created only if the admin account does not exist)
SUMA_ADMIN_PASSWORD=Change-Me-Admin-1
# Outgoing email. Defaults to the local Mailpit capture server.
SUMA_SMTP_HOST=mailpit
SUMA_SMTP_PORT=1025
SUMA_MAIL_FROM=suma-noreply@localhost
SUMA_PUBLIC_URL=http://localhost:8081
# CIDRs of reverse proxies whose X-Forwarded-For header may be trusted
SUMA_TRUSTED_PROXIES=172.16.0.0/12
SUMA_CORS_ORIGINS=http://localhost:8081
# Set to true behind HTTPS
SUMA_COOKIE_SECURE=false
# Demo data for evaluation only
SUMA_DEMO_DATA=True
